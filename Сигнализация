const int ledPin = 9;      // Светодиод
const int buzzerPin = 8;   // Пьезопищалка
const int armBtn = 10;     // Кнопка включения охраны
const int sensorBtn = 11;  // Кнопка-датчик
const int potPin = A0;     // Потенциометр

bool armed = false;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(armBtn, INPUT_PULLUP);
  pinMode(sensorBtn, INPUT_PULLUP);
}

void loop() {
  // Проверяем нажатие кнопки активации охраны
  if (digitalRead(armBtn) == LOW) {
    armed = !armed; // Меняем статус (вкл/выкл)
    delay(300);     // Задержка от дребезга контактов
  }

  // Если охрана включена и сработал датчик
  if (armed && digitalRead(sensorBtn) == LOW) {
    // Считываем потенциометр и переводим в диапазон от 1000 до 5000 мс
    int timeMs = map(analogRead(potPin), 0, 1023, 1000, 5000);
    runAlarm(timeMs); 
  }
}

// Пример функции runAlarm (добавьте её, если её ещё нет в коде)
void runAlarm(int duration) {
  digitalWrite(ledPin, HIGH);
  tone(buzzerPin, 1000); // Включаем пищалку на частоте 1000 Гц
  delay(duration);       // Ждем переданное время
  digitalWrite(ledPin, LOW);
  noTone(buzzerPin);     // Выключаем пищалку
}
